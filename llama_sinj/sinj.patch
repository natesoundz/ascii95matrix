+bool llama_adapter_sinj::apply(
+        const llama_model & model,
+        const llama_sinj_entry * entries_in,
+        size_t n_entries,
+        int32_t n_embd_in) {
+    const auto & hparams = model.hparams;
+
+    if (entries_in == nullptr || n_entries == 0) {
+        entries.clear();
+        bufs.clear();
+        ctxs.clear();
+        n_embd = 0;
+        return true;
+    }
+
+    if (n_embd_in != (int32_t) hparams.n_embd) {
+        LLAMA_LOG_ERROR("%s: symbolic injection n_embd does not match model\n", __func__);
+        return false;
+    }
+
+    std::vector<std::vector<float>> values;
+    values.reserve(n_entries);
+
+    for (size_t i = 0; i < n_entries; ++i) {
+        const llama_sinj_entry & entry = entries_in[i];
+        if (entry.layer < 0 || (uint32_t) entry.layer >= hparams.n_layer() ||
+            entry.point < LLAMA_SINJ_POINT_ATTN ||
+            entry.point > LLAMA_SINJ_POINT_BLOCK ||
+            entry.data == nullptr ||
+            entry.pos_start < -1 ||
+            entry.pos_end < -1 ||
+            (entry.pos_start >= 0 && entry.pos_end >= 0 && entry.pos_start >= entry.pos_end)) {
+            LLAMA_LOG_ERROR("%s: invalid symbolic injection entry %zu\n", __func__, i);
+            return false;
+        }
+
+        values.emplace_back(entry.data, entry.data + n_embd_in);
+    }
+
+    this->entries.clear();
+    bufs.clear();
+    ctxs.clear();
+    n_embd = n_embd_in;
+
+    std::map<ggml_backend_buffer_type_t, ggml_context *> ctx_map;
+    auto ctx_for_buft = [&](ggml_backend_buffer_type_t buft) -> ggml_context * {
+        auto it = ctx_map.find(buft);
+        if (it != ctx_map.end()) {
+            return it->second;
+        }
+
+        ggml_init_params params = {
+            /*.mem_size   =*/ n_entries * ggml_tensor_overhead(),
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context * ctx = ggml_init(params);
+        if (!ctx) {
+            return nullptr;
+        }
+
+        ctx_map[buft] = ctx;
+        ctxs.emplace_back(ctx);
+        return ctx;
+    };
+
+    this->entries.reserve(n_entries);
+    for (size_t i = 0; i < n_entries; ++i) {
+        const llama_sinj_entry & entry = entries_in[i];
+        ggml_backend_buffer_type_t buft = model.select_buft(entry.layer);
+        ggml_context * ctx = ctx_for_buft(buft);
+        if (!ctx) {
+            LLAMA_LOG_ERROR("%s: failed to allocate context for symbolic injection\n", __func__);
+            this->entries.clear();
+            bufs.clear();
+            ctxs.clear();
+            n_embd = 0;
+            return false;
+        }
+
+        llama_adapter_sinj_entry stored = {
+            entry.layer,
+            entry.point,
+            entry.gain,
+            entry.rms_scale,
+            entry.pos_start,
+            entry.pos_end,
+            entry.decode_only,
+            ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd),
+        };
+        this->entries.push_back(stored);
+    }
+
+    bufs.reserve(ctx_map.size());
+    for (const auto & [buft, ctx] : ctx_map) {
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+        if (!buf) {
+            LLAMA_LOG_ERROR("%s: failed to allocate buffer for symbolic injection\n", __func__);
+            this->entries.clear();
+            bufs.clear();
+            ctxs.clear();
+            n_embd = 0;
+            return false;
+        }
+        bufs.emplace_back(buf);
+    }
+
+    for (size_t i = 0; i < this->entries.size(); ++i) {
+        ggml_backend_tensor_set(
+            this->entries[i].tensor,
+            values[i].data(),
+            0,
+            values[i].size() * sizeof(float));
+    }
+
+    return true;
+}
