+#include "common.h"
+#include "json.h"
+#include "llama.h"
+
+#include <cmath>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+struct capture_state {
+    std::string name;
+    int n_tokens = 0;
+    std::vector<float> values;
+};
+
+static bool capture_tensor(ggml_tensor * tensor, bool ask, void * user_data) {
+    auto * state = static_cast<capture_state *>(user_data);
+    const bool match = std::string(tensor->name) == state->name;
+    if (ask) {
+        return match;
+    }
+    if (!match) {
+        return true;
+    }
+    if (tensor->type != GGML_TYPE_F32 || tensor->ne[1] != state->n_tokens) {
+        return true;
+    }
+    state->values.resize(ggml_nelements(tensor));
+    ggml_backend_tensor_get(tensor, state->values.data(), 0, ggml_nbytes(tensor));
+    return true;
+}
+
+static std::vector<float> evaluate(
+        llama_context * ctx,
+        const std::string & text,
+        bool add_bos,
+        const std::string & tensor_name,
+        capture_state & state) {
+    auto tokens = common_tokenize(ctx, text, add_bos, true);
+    if (tokens.empty()) {
+        throw std::runtime_error("text tokenized to an empty sequence");
+    }
+    state.name = tensor_name;
+    state.n_tokens = tokens.size();
+    state.values.clear();
+    llama_memory_clear(llama_get_memory(ctx), true);
+    common_batch batch(ctx);
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        batch.add(tokens[i], i, 0, true);
+    }
+    if (llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, batch.get())) {
+        throw std::runtime_error("failed to evaluate text");
+    }
+    if (state.values.empty()) {
+        throw std::runtime_error("requested activation was not captured");
+    }
+    const size_t n_embd = state.values.size() / tokens.size();
+    std::vector<float> mean(n_embd, 0.0f);
+    for (size_t token = 0; token < tokens.size(); ++token) {
+        for (size_t i = 0; i < n_embd; ++i) {
+            mean[i] += state.values[token * n_embd + i] / tokens.size();
+        }
+    }
+    return mean;
+}
+
+int main(int argc, char ** argv) {
+    std::string model;
+    std::string text;
+    std::string contrast;
+    std::string point;
+    std::string output;
+    int layer = -1;
+    int sid = 0;
+    float gain = 1.0f;
+
+    for (int i = 1; i < argc; ++i) {
+        const std::string arg = argv[i];
+        auto value = [&]() -> std::string {
+            if (++i >= argc) throw std::invalid_argument("missing value for " + arg);
+            return argv[i];
+        };
+        if (arg == "-m" || arg == "--model") model = value();
+        else if (arg == "--text") text = value();
+        else if (arg == "--contrast") contrast = value();
+        else if (arg == "--layer") layer = std::stoi(value());
+        else if (arg == "--point") point = value();
+        else if (arg == "--gain") gain = std::stof(value());
+        else if (arg == "--sid") sid = std::stoi(value());
+        else if (arg == "-o") output = value();
+        else if (arg == "-h" || arg == "--help") {
+            std::printf("usage: llama-sinj-extract -m model --text words [--contrast words] --layer L --point attn|mlp|block [--gain G] [--sid N] -o sidecar.json\n");
+            return 0;
+        } else {
+            std::fprintf(stderr, "unknown argument: %s\n", arg.c_str());
+            return 2;
+        }
+    }
+    if (model.empty() || text.empty() || output.empty() || layer < 0 ||
+        (point != "attn" && point != "mlp" && point != "block")) {
+        std::fprintf(stderr, "model, text, layer, point, and output are required\n");
+        return 2;
+    }
+
+    try {
+        capture_state state;
+        common_params params;
+        params.model.path = model;
+        params.n_outputs_max = params.n_batch;
+        params.warmup = false;
+        postprocess_cpu_params(params.cpuparams);
+        postprocess_cpu_params(params.cpuparams_batch, &params.cpuparams);
+        params.cb_eval = capture_tensor;
+        params.cb_eval_user_data = &state;
+        common_init();
+        llama_backend_init();
+        auto init = common_init_from_params(params);
+        llama_context * ctx = init->context();
+        llama_model * loaded_model = init->model();
+        if (!ctx || !loaded_model) throw std::runtime_error("failed to load model");
+        if (layer >= llama_model_n_layer(loaded_model)) throw std::invalid_argument("layer is out of range");
+
+        const std::string prefix = point == "attn" ? "attn_out-" : point == "mlp" ? "ffn_out-" : "l_out-";
+        const std::string tensor_name = prefix + std::to_string(layer);
+        const llama_vocab * vocab = llama_model_get_vocab(loaded_model);
+        const bool add_bos = llama_vocab_get_add_bos(vocab);
+        std::vector<float> vector = evaluate(ctx, text, add_bos, tensor_name, state);
+        if (!contrast.empty()) {
+            const auto negative = evaluate(ctx, contrast, add_bos, tensor_name, state);
+            if (negative.size() != vector.size()) throw std::runtime_error("activation dimensions differ");
+            for (size_t i = 0; i < vector.size(); ++i) vector[i] -= negative[i];
+        }
+        double sum = 0.0;
+        for (float value : vector) sum += double(value) * value;
+        const double rms = std::sqrt(sum / vector.size());
+        if (!std::isfinite(rms) || rms == 0.0) throw std::runtime_error("cannot normalize a zero or non-finite vector");
+        for (float & value : vector) value = float(value / rms);
+
+        common_json sidecar = {
+            {"format", "symbolic-vector-sidecar-v1"},
+            {"model", std::filesystem::path(model).filename().string()},
+            {"vectors", common_json::array()},
+        };
+        if (std::filesystem::exists(output)) {
+            std::ifstream input(output);
+            std::stringstream contents;
+            contents << input.rdbuf();
+            sidecar = common_json::parse(contents.str());
+            common_sinj_load(sidecar, llama_model_n_layer(loaded_model), llama_model_n_embd(loaded_model));
+            if (sidecar.value("model", "") != std::filesystem::path(model).filename().string()) {
+                throw std::invalid_argument("existing sidecar model does not match");
+            }
+        }
+        sidecar["model"] = std::filesystem::path(model).filename().string();
+        common_json headwords = common_json::array();
+        headwords.push_back(text);
+        common_json contrasts = common_json::array();
+        if (!contrast.empty()) contrasts.push_back(contrast);
+        sidecar["vectors"].push_back({
+            {"sid", sid}, {"headwords", headwords}, {"contrast", contrasts},
+            {"layer", layer}, {"point", point}, {"gain", gain}, {"at", "all"},
+            {"dim", vector.size()}, {"vector", vector}, {"rms_scale", true},
+        });
+        std::ofstream file(output);
+        if (!file) throw std::runtime_error("failed to open output file");
+        file << sidecar.dump(2) << "\n";
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "error: %s\n", e.what());
+        return 1;
+    }
+    return 0;
+}
