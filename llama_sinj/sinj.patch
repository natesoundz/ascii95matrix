+
+struct capture_state {
+    std::set<std::string> names;
+    std::map<std::string, std::vector<float>> values;
+    int32_t n_tokens = 0;
+};
+
+static bool cb_eval(ggml_tensor * tensor, bool ask, void * user_data) {
+    auto * state = static_cast<capture_state *>(user_data);
+    const std::string name = tensor->name;
+    const bool match = state->names.count(name) != 0;
+    if (ask) {
+        return match;
+    }
+    if (!match || tensor->type != GGML_TYPE_F32 || tensor->ne[1] != state->n_tokens) {
+        return true;
+    }
+    auto & values = state->values[name];
+    values.resize(ggml_nelements(tensor));
+    ggml_backend_tensor_get(tensor, values.data(), 0, ggml_nbytes(tensor));
+    return true;
+}
+
+static std::vector<float> run(
+        llama_context * ctx,
+        llama_model * model,
+        const std::vector<llama_token> & tokens,
+        const std::vector<llama_sinj_entry> & entries,
+        capture_state & capture,
+        bool all_outputs = true) {
+    const int32_t n_embd = llama_model_n_embd(model);
+    if (llama_set_adapter_sinj(ctx, entries.empty() ? nullptr : entries.data(), entries.size(), n_embd) != 0) {
+        throw std::runtime_error("failed to set sinj entries");
+    }
+    capture.n_tokens = all_outputs ? tokens.size() : 1;
+    capture.values.clear();
+    llama_memory_clear(llama_get_memory(ctx), true);
+    common_batch batch(ctx);
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        batch.add(tokens[i], i, 0, all_outputs || i + 1 == tokens.size());
+    }
+    if (llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, batch.get())) {
+        throw std::runtime_error("failed to evaluate prompt");
+    }
+    const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    const float * logits = llama_get_logits_ith(ctx, -1);
+    if (!logits) {
+        throw std::runtime_error("logits are unavailable");
+    }
+    return std::vector<float>(logits, logits + n_vocab);
+}
+
+static std::vector<llama_token> tokenize(llama_context * ctx, const std::string & text) {
+    return common_tokenize(ctx, text, true, true);
+}
+
+static std::vector<float> decode_one(
+        llama_context * ctx, llama_model * model, llama_token token, llama_pos pos) {
+    common_batch batch(ctx);
+    batch.add(token, pos, 0, true);
+    if (llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, batch.get())) {
+        throw std::runtime_error("failed during single-token decode");
+    }
+    const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    const float * logits = llama_get_logits_ith(ctx, -1);
+    if (!logits) {
+        throw std::runtime_error("decode logits are unavailable");
+    }
+    return std::vector<float>(logits, logits + n_vocab);
+}
+
+static float max_diff(const std::vector<float> & a, const std::vector<float> & b) {
+    if (a.size() != b.size()) throw std::runtime_error("tensor dimensions differ");
+    float result = 0.0f;
+    for (size_t i = 0; i < a.size(); ++i) result = std::max(result, std::abs(a[i] - b[i]));
+    return result;
+}
+
+static void assert_identical(const char * label, const std::vector<float> & a, const std::vector<float> & b) {
+    if (a.size() != b.size() || std::memcmp(a.data(), b.data(), a.size() * sizeof(float)) != 0) {
+        throw std::runtime_error(std::string(label) + " is not bit-identical");
+    }
+    std::printf("%s max_abs_diff=0\n", label);
+}
+
+static void check_math(
+        const char * label,
+        const std::vector<float> & pre,
+        const std::vector<float> & post,
+        const std::vector<float> & vector,
+        int32_t n_tokens,
+        float gain,
+        bool rms_scale,
+        int32_t pos_start,
+        int32_t pos_end) {
+    const size_t n_embd = vector.size();
+    if (pre.size() != n_embd * n_tokens || post.size() != pre.size()) {
+        throw std::runtime_error(std::string(label) + " captured tensor shape mismatch");
+    }
+    float max_error = 0.0f;
+    for (int32_t token = 0; token < n_tokens; ++token) {
+        double sum = 0.0;
+        for (size_t i = 0; i < n_embd; ++i) {
+            const float value = pre[token * n_embd + i];
+            sum += double(value) * value;
+        }
+        const float scale = gain * (rms_scale ? std::sqrt(sum / n_embd) : 1.0f);
+        const bool selected = token >= pos_start && token < pos_end;
+        for (size_t i = 0; i < n_embd; ++i) {
+            const float delta = post[token * n_embd + i] - pre[token * n_embd + i];
+            const float expected = selected ? scale * vector[i] : 0.0f;
+            max_error = std::max(max_error, std::abs(delta - expected));
+            if (!selected && delta != 0.0f) {
+                throw std::runtime_error(std::string(label) + " changed an unselected token");
+            }
+            if (std::abs(delta - expected) > 1e-3f * std::max(std::abs(expected), 1e-4f)) {
+                throw std::runtime_error(std::string(label) + " injection math mismatch");
+            }
+        }
+    }
+    std::printf("%s max_abs_diff=%g\n", label, max_error);
+}
+
+static std::vector<llama_token> generate(
+        llama_context * ctx,
+        llama_model * model,
+        const std::vector<llama_token> & prompt,
+        const std::vector<llama_sinj_entry> & entries,
+        int n_steps) {
+    const int32_t n_embd = llama_model_n_embd(model);
+    if (llama_set_adapter_sinj(ctx, entries.empty() ? nullptr : entries.data(), entries.size(), n_embd) != 0) {
+        throw std::runtime_error("failed to set decode injection");
+    }
+    llama_memory_clear(llama_get_memory(ctx), true);
+    common_batch batch(ctx);
+    for (size_t i = 0; i < prompt.size(); ++i) batch.add(prompt[i], i, 0, i + 1 == prompt.size());
+    if (llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, batch.get())) {
+        throw std::runtime_error("failed to decode prompt");
+    }
+
+    const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    std::vector<llama_token> generated;
+    for (int i = 0; i < n_steps; ++i) {
+        const float * logits = llama_get_logits_ith(ctx, -1);
+        const llama_token token = (llama_token) (std::max_element(logits, logits + n_vocab) - logits);
+        generated.push_back(token);
+        common_batch next(ctx);
+        next.add(token, prompt.size() + i, 0, true);
+        if (llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, next.get())) {
+            throw std::runtime_error("failed during greedy decode");
+        }
+    }
+    return generated;
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 2) {
+        std::fprintf(stderr, "usage: test-sinj model.gguf\n");
+        return 2;
+    }
+    try {
+        common_init();
+        llama_backend_init();
+        common_params params;
+        params.model.path = argv[1];
+        params.n_ctx = 256;
+        params.n_batch = 256;
+        params.n_ubatch = 256;
+        params.n_outputs_max = 256;
+        params.warmup = false;
+        postprocess_cpu_params(params.cpuparams);
+        postprocess_cpu_params(params.cpuparams_batch, &params.cpuparams);
+        capture_state capture;
+        params.cb_eval = cb_eval;
+        params.cb_eval_user_data = &capture;
+        auto init = common_init_from_params(params);
+        llama_context * ctx = init->context();
+        llama_model * model = init->model();
+        if (!ctx || !model) throw std::runtime_error("failed to load model");
+        if (llama_model_n_layer(model) <= 10) throw std::runtime_error("model needs at least 11 layers");
+
+        const auto tokens = tokenize(ctx, "The sky is blue and the grass is green.");
+        const int32_t n_embd = llama_model_n_embd(model);
+        std::vector<float> vector(n_embd, 1.0f);
+        llama_sinj_entry entry = { 10, LLAMA_SINJ_POINT_BLOCK, 2.0f, true, 2, 5, vector.data(), false };
+
+        capture.names = { "attn_out-10", "ffn_out-10", "l_out-10" };
+        const auto baseline = run(ctx, model, tokens, {}, capture);
+        const auto baseline_attn = capture.values.at("attn_out-10");
+        const auto baseline_mlp = capture.values.at("ffn_out-10");
+        const auto baseline_block = capture.values.at("l_out-10");
+
+        entry.gain = 0.0f;
+        assert_identical("zero_gain_logits", baseline, run(ctx, model, tokens, { entry }, capture));
+        entry.gain = 2.0f;
+        run(ctx, model, tokens, { entry }, capture);
+        assert_identical("set_then_clear_logits", baseline, run(ctx, model, tokens, {}, capture));
+
+        const struct {
+            llama_sinj_point point;
+            const char * before;
+            const char * after;
+            const std::vector<float> * baseline_values;
+            bool rms_scale;
+            const char * label;
+        } checks[] = {
+            { LLAMA_SINJ_POINT_BLOCK, "l_out-10", "sinj_block-10", &baseline_block, true, "block_rms" },
+            { LLAMA_SINJ_POINT_MLP, "ffn_out-10", "sinj_mlp-10", &baseline_mlp, true, "mlp_rms" },
+            { LLAMA_SINJ_POINT_ATTN, "attn_out-10", "sinj_attn-10", &baseline_attn, true, "attn_rms" },
+            { LLAMA_SINJ_POINT_MLP, "ffn_out-10", "sinj_mlp-10", &baseline_mlp, false, "mlp_no_rms" },
+        };
+        for (const auto & check : checks) {
+            capture.names = { check.before, check.after };
+            entry.point = check.point;
+            entry.rms_scale = check.rms_scale;
+            run(ctx, model, tokens, { entry }, capture);
+            check_math(check.label, *check.baseline_values, capture.values.at(check.after),
+                    vector, tokens.size(), entry.gain, check.rms_scale, 2, 5);
+        }
+
+        const int32_t last_layer = llama_model_n_layer(model) - 1;
+        entry.layer = last_layer;
+        entry.rms_scale = false;
+        entry.pos_start = -1;
+        entry.pos_end = -1;
+        for (const auto point : { LLAMA_SINJ_POINT_MLP, LLAMA_SINJ_POINT_BLOCK }) {
+            entry.point = point;
+            capture.names = { point == LLAMA_SINJ_POINT_MLP ? "sinj_mlp-" + std::to_string(last_layer) :
+                                                            "sinj_block-" + std::to_string(last_layer) };
+            const auto no_entry = run(ctx, model, tokens, {}, capture, false);
+            const auto injected = run(ctx, model, tokens, { entry }, capture, false);
+            if (std::memcmp(no_entry.data(), injected.data(), no_entry.size() * sizeof(float)) == 0) {
+                throw std::runtime_error("last-layer injection did not change logits");
+            }
+            std::printf("last_layer_point_%d max_abs_diff=%g\n", point, max_diff(no_entry, injected));
+        }
+
+        entry.layer = 10;
+        entry.point = LLAMA_SINJ_POINT_BLOCK;
+        entry.gain = 2.0f;
+        entry.rms_scale = true;
+        entry.pos_start = -1;
+        entry.pos_end = -1;
+        entry.decode_only = true;
+        capture.names.clear();
+        const auto prompt_baseline = run(ctx, model, tokens, {}, capture, false);
+        const llama_token next_token = (llama_token) (
+                std::max_element(prompt_baseline.begin(), prompt_baseline.end()) - prompt_baseline.begin());
+        const auto continuation_baseline = decode_one(ctx, model, next_token, tokens.size());
+        const auto prompt_decode_only = run(ctx, model, tokens, { entry }, capture, false);
+        assert_identical("decode_only_prompt_logits", prompt_baseline, prompt_decode_only);
+        const auto continuation_decode_only = decode_one(ctx, model, next_token, tokens.size());
+        const float decode_only_diff = max_diff(continuation_baseline, continuation_decode_only);
+        if (decode_only_diff == 0.0f) {
+            throw std::runtime_error("decode-only injection did not change single-token decode logits");
+        }
+        std::printf("decode_only_next_logits max_abs_diff=%g\n", decode_only_diff);
+
+        entry.layer = 10;
+        entry.point = LLAMA_SINJ_POINT_BLOCK;
+        entry.rms_scale = true;
+        entry.pos_start = -1;
+        entry.pos_end = -1;
+        entry.decode_only = false;
+        const auto baseline_tokens = generate(ctx, model, tokens, {}, 16);
+        const auto injected_tokens = generate(ctx, model, tokens, { entry }, 16);
+        if (baseline_tokens == injected_tokens) throw std::runtime_error("decode tokens did not change");
+        std::printf("decode_16_tokens_differ=true\n");
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "test-sinj: %s\n", e.what());
+        return 1;
+    }
+    return 0;
+}
