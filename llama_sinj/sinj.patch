+static int32_t common_sinj_point(const common_json & value) {
+    const std::string point = value.get<std::string>();
+    if (point == "attn") {
+        return LLAMA_SINJ_POINT_ATTN;
+    }
+    if (point == "mlp") {
+        return LLAMA_SINJ_POINT_MLP;
+    }
+    if (point == "block") {
+        return LLAMA_SINJ_POINT_BLOCK;
+    }
+    throw std::invalid_argument("invalid point");
+}
+
+static void common_sinj_refresh_api(common_sinj_data & result) {
+    result.api_entries.clear();
+    result.api_entries.reserve(result.entries.size());
+    for (auto & entry : result.entries) {
+        entry.entry.data = entry.data.data();
+        result.api_entries.push_back(entry.entry);
+    }
+}
+
+common_sinj_data common_sinj_load(const common_json & sidecar, int32_t n_layer, int32_t n_embd) {
+    if (sidecar.value("format", "") != "symbolic-vector-sidecar-v1") {
+        throw std::invalid_argument("sinj sidecar: invalid format");
+    }
+    if (!sidecar.contains("vectors") || !sidecar["vectors"].is_array()) {
+        throw std::invalid_argument("sinj sidecar: vectors must be an array");
+    }
+    if (sidecar["vectors"].size() > 256) {
+        throw std::invalid_argument("sinj sidecar: too many vectors");
+    }
+
+    common_sinj_data result;
+    result.n_embd = n_embd;
+    for (size_t index = 0; index < sidecar["vectors"].size(); ++index) {
+        const common_json & item = sidecar["vectors"][index];
+        try {
+            const int layer = item.at("layer").get<int>();
+            const int dim = item.at("dim").get<int>();
+            if (!item.at("vector").is_array() || item.at("vector").size() != (size_t) n_embd) {
+                throw std::invalid_argument("invalid vector dimension");
+            }
+            const auto values = item.at("vector").get<std::vector<float>>();
+            if (n_embd <= 0 || layer < 0 || layer >= n_layer || dim != n_embd || (int) values.size() != n_embd) {
+                throw std::invalid_argument("invalid layer or vector dimension");
+            }
+
+            double sum = 0.0;
+            for (float value : values) {
+                if (!std::isfinite(value)) throw std::invalid_argument("vector contains a non-finite value");
+                sum += double(value) * value;
+            }
+            if (std::abs(std::sqrt(sum / n_embd) - 1.0) > 1e-3) {
+                throw std::invalid_argument("vector is not unit RMS");
+            }
+
+            const int32_t point = common_sinj_point(item.at("point"));
+            const float gain = item.value("gain", 1.0f);
+            if (!std::isfinite(gain)) throw std::invalid_argument("gain is not finite");
+            const bool rms_scale = item.value("rms_scale", true);
+            int32_t explicit_start = item.value("pos_start", -1);
+            int32_t explicit_end = item.value("pos_end", -1);
+            if (explicit_start < -1 || explicit_end < -1) {
+                throw std::invalid_argument("invalid position bounds");
+            }
+
+            std::vector<std::pair<int32_t, int32_t>> runs;
+            const common_json & at = item.at("at");
+            if (at.is_string() && (at == "all" || at == "current")) {
+                runs.emplace_back(-1, -1);
+            } else {
+                std::vector<int32_t> positions;
+                if (at == "here") {
+                    if (!item.contains("positions") || !item["positions"].is_array()) {
+                        throw std::invalid_argument("here requires positions");
+                    }
+                    positions = item["positions"].get<std::vector<int32_t>>();
+                } else if (at.is_array()) {
+                    positions = at.get<std::vector<int32_t>>();
+                } else {
+                    throw std::invalid_argument("invalid at");
+                }
+                if (positions.size() > 65536 ||
+                    std::any_of(positions.begin(), positions.end(), [](int32_t pos) { return pos < 0 || pos == INT32_MAX; })) {
+                    throw std::invalid_argument("invalid positions");
+                }
+                std::sort(positions.begin(), positions.end());
+                positions.erase(std::unique(positions.begin(), positions.end()), positions.end());
+                for (size_t i = 0; i < positions.size();) {
+                    size_t j = i + 1;
+                    while (j < positions.size() && positions[j] == positions[j - 1] + 1) ++j;
+                    runs.emplace_back(positions[i], positions[j - 1] + 1);
+                    i = j;
+                }
+            }
+            for (const auto & run : runs) {
+                if (result.entries.size() >= 256) {
+                    throw std::invalid_argument("too many expanded position runs");
+                }
+                const int32_t start = explicit_start >= 0 ? explicit_start : run.first;
+                const int32_t end = explicit_end >= 0 ? explicit_end : run.second;
+                if (start >= 0 && end >= 0 && start >= end) {
+                    throw std::invalid_argument("invalid position bounds");
+                }
+                common_sinj_entry entry;
+                entry.entry = { layer, point, gain, rms_scale,
+                    start, end, nullptr, false };
+                entry.data = values;
+                entry.sid = item.value("sid", 0);
+                result.entries.push_back(std::move(entry));
+            }
+        } catch (const std::exception & e) {
+            throw std::invalid_argument(string_format("sinj entry %zu: %s", index, e.what()));
+        }
+    }
+    common_sinj_refresh_api(result);
+    return result;
+}
+
+common_sinj_data common_sinj_load_file(const std::string & path, int32_t n_layer, int32_t n_embd) {
+    std::ifstream file(path);
+    if (!file) throw std::invalid_argument("failed to open sinj sidecar: " + path);
+    std::stringstream contents;
+    contents << file.rdbuf();
+    return common_sinj_load(common_json::parse(contents.str()), n_layer, n_embd);
+}
+
+common_sinj_data common_sinj_load_symbolic_file(const std::string & path, int32_t n_layer, int32_t n_embd) {
+    std::ifstream in(path);
+    if (!in) {
+        throw std::invalid_argument("symbolic-file: failed to open: " + path);
+    }
+
+    auto next_line = [&in](std::string & line) {
+        while (std::getline(in, line)) {
+            if (!line.empty() && line.back() == '\r') {
+                line.pop_back();
+            }
+            const size_t first = line.find_first_not_of(" \t\r\n");
+            if (first == std::string::npos || line[first] == '#') {
+                continue;
+            }
+            line = line.substr(first);
+            return true;
+        }
+        return false;
+    };
+
+    std::string line;
+    if (!next_line(line) || line != "symbolic-file-v1") {
+        throw std::invalid_argument("symbolic-file: expected symbolic-file-v1 header in " + path);
+    }
+
+    int64_t file_n_embd = -1;
+    if (!next_line(line)) {
+        throw std::invalid_argument("symbolic-file: missing n_embd in " + path);
+    }
+    {
+        std::istringstream ss(line);
+        std::string tag;
+        if (!(ss >> tag >> file_n_embd) || tag != "n_embd" || file_n_embd <= 0) {
+            throw std::invalid_argument("symbolic-file: invalid n_embd line in " + path);
+        }
+        std::string extra;
+        if (ss >> extra) {
+            throw std::invalid_argument("symbolic-file: invalid n_embd line in " + path);
+        }
+    }
+    if (n_embd <= 0 || file_n_embd != n_embd) {
+        throw std::invalid_argument("symbolic-file: n_embd does not match model in " + path);
+    }
+
+    common_sinj_data result;
+    result.n_embd = n_embd;
+    while (next_line(line)) {
+        std::istringstream ss(line);
+        std::string tag;
+        std::string point_name;
+        std::string at;
+        int32_t layer = -1;
+        float gain = 0.0f;
+        if (!(ss >> tag >> layer >> point_name >> gain >> at) || tag != "injection") {
+            throw std::invalid_argument("symbolic-file: invalid injection line in " + path);
+        }
+        std::string extra;
+        if (ss >> extra) {
+            throw std::invalid_argument("symbolic-file: invalid injection line in " + path);
+        }
+
+        int32_t point = -1;
+        if (point_name == "attn") {
+            point = LLAMA_SINJ_POINT_ATTN;
+        } else if (point_name == "mlp") {
+            point = LLAMA_SINJ_POINT_MLP;
+        } else if (point_name == "block") {
+            point = LLAMA_SINJ_POINT_BLOCK;
+        } else {
+            throw std::invalid_argument("symbolic-file: invalid point in " + path);
+        }
+        if (layer < 0 || layer >= n_layer) {
+            throw std::invalid_argument("symbolic-file: layer is out of range in " + path);
+        }
+        if (!std::isfinite(gain)) {
+            throw std::invalid_argument("symbolic-file: gain is not finite in " + path);
+        }
+        if (at != "all" && at != "current") {
+            throw std::invalid_argument("symbolic-file: invalid at value in " + path);
+        }
+
+        if (!next_line(line)) {
+            throw std::invalid_argument("symbolic-file: injection has no vector in " + path);
+        }
+        std::istringstream vs(line);
+        std::string vector_tag;
+        if (!(vs >> vector_tag) || vector_tag != "vector") {
+            throw std::invalid_argument("symbolic-file: expected vector line in " + path);
+        }
+        std::vector<float> values;
+        float value = 0.0f;
+        while (vs >> value) {
+            values.push_back(value);
+        }
+        if (!vs.eof()) {
+            throw std::invalid_argument("symbolic-file: invalid vector value in " + path);
+        }
+        if ((int64_t) values.size() != file_n_embd) {
+            throw std::invalid_argument("symbolic-file: vector length does not match n_embd in " + path);
+        }
+
+        double sum = 0.0;
+        for (float x : values) {
+            if (!std::isfinite(x)) {
+                throw std::invalid_argument("symbolic-file: vector contains a non-finite value in " + path);
+            }
+            sum += double(x) * x;
+        }
+        if (std::abs(std::sqrt(sum / n_embd) - 1.0) > 1e-3) {
+            throw std::invalid_argument("symbolic-file: vector is not unit RMS in " + path);
+        }
+
+        common_sinj_entry entry;
+        entry.entry = { layer, point, gain, true, -1, -1, nullptr, at == "current" };
+        entry.data = std::move(values);
+        result.entries.push_back(std::move(entry));
+    }
+    if (result.entries.empty()) {
+        throw std::invalid_argument("symbolic-file: no injections in " + path);
+    }
+
+    common_sinj_refresh_api(result);
+    return result;
+}
+
+common_sinj_data common_sinj_load_files(
+        const std::string & sidecar_path, const std::string & symbolic_path, int32_t n_layer, int32_t n_embd) {
+    common_sinj_data result;
+    result.n_embd = n_embd;
+    if (!sidecar_path.empty()) {
+        result = common_sinj_load_file(sidecar_path, n_layer, n_embd);
+    }
+    if (!symbolic_path.empty()) {
+        common_sinj_data symbolic = common_sinj_load_symbolic_file(symbolic_path, n_layer, n_embd);
+        for (auto & entry : symbolic.entries) {
+            result.entries.push_back(std::move(entry));
+        }
+    }
+    common_sinj_refresh_api(result);
+    return result;
+}
