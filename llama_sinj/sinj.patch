+ggml_tensor * llm_graph_context::build_sinj(
+         ggml_tensor * cur,
+                 int   il,
+    llama_sinj_point point,
+         ggml_tensor * out_ids) const {
+    if (sinj == nullptr || sinj->empty() || inp_sinj == nullptr) {
+        return cur;
+    }
+
+    ggml_tensor * base = cur;
+    bool changed = false;
+    const auto & entries = sinj->get_entries();
+    for (size_t i = 0; i < entries.size(); ++i) {
+        const auto & entry = entries[i];
+        if (entry.layer != il || entry.point != point) {
+            continue;
+        }
+
+        ggml_tensor * mask = inp_sinj->masks[i];
+        if (cur->ne[1] != mask->ne[1]) {
+            GGML_ASSERT(out_ids != nullptr);
+            mask = ggml_get_rows(ctx0, mask, out_ids);
+        }
+
+        ggml_tensor * scale = mask;
+        if (entry.rms_scale) {
+            ggml_tensor * rms = ggml_sqrt(ctx0, ggml_scale(ctx0,
+                    ggml_sum_rows(ctx0, ggml_sqr(ctx0, base)),
+                    1.0f / n_embd));
+            scale = ggml_mul(ctx0, rms, mask);
+        }
+        scale = ggml_scale(ctx0, scale, entry.gain);
+        cur = ggml_add(ctx0, cur, ggml_mul(ctx0, ggml_repeat(ctx0, entry.tensor, cur), scale));
+        changed = true;
+    }
+
+    if (changed) {
+        const char * name = point == LLAMA_SINJ_POINT_ATTN ? "sinj_attn" :
+                            point == LLAMA_SINJ_POINT_MLP  ? "sinj_mlp"  : "sinj_block";
+        cb(cur, name, il);
+        if (point == LLAMA_SINJ_POINT_BLOCK) {
+            cur = ggml_cont(ctx0, cur);
+        }
+    }
+
+    return cur;
+}
